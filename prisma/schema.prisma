// Prisma schema — targets Supabase Postgres.
// Set DATABASE_URL (pooled, for the app) and DIRECT_URL (direct, for migrations)
// from your Supabase project's Database settings.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String
  phone         String    @unique
  email         String?   @unique
  passwordHash  String?
  image         String?
  role          String    @default("user") // "user" | "admin"
  emailVerified DateTime?
  createdAt     DateTime  @default(now())

  papers   Paper[]
  orders   Order[]
  accounts Account[]
  sessions Session[]
}

model Paper {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("Untitled Question Paper")
  className String?
  subject   String?
  // Full PaperDoc JSON (see lib/paper/types.ts).
  doc       Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([userId])
}

model Order {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  paperId   String
  paper     Paper    @relation(fields: [paperId], references: [id], onDelete: Cascade)
  // "PDF" | "DOCX"
  format    String
  amount    Int // in paise (e.g. 1000 = ₹10.00)
  currency  String   @default("INR")
  // "pending" | "paid" | "failed"
  status    String   @default("pending")
  // Payment provider: "upi_static" | "razorpay" | "cashfree"
  provider  String   @default("upi_static")
  // User-submitted UPI transaction reference (UTR) for static-QR flow.
  utr       String?
  // Payment screenshot (data URL) the user uploads as proof.
  screenshotUrl String?
  // Provider payment id once a gateway is wired in.
  providerRef String?
  createdAt DateTime @default(now())
  paidAt    DateTime?

  messages Message[]

  @@index([userId])
  @@index([status])
}

// Per-request help chat between the user and the admin (last 15 kept).
model Message {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sender    String // "user" | "admin"
  body      String
  createdAt DateTime @default(now())

  @@index([orderId])
}

// --- Auth.js (NextAuth) adapter tables ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
